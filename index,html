<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Ultimate Pong</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    background:
        radial-gradient(circle at center, #172033 0%, #070a10 60%, #020306 100%);
    color: white;
    font-family: Arial, Helvetica, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.game-container {
    width: 100%;
    max-width: 1100px;
    text-align: center;
    padding: 15px;
}

h1 {
    margin: 0 0 10px;
    font-size: clamp(28px, 5vw, 48px);
    letter-spacing: 4px;
    color: #fff;
    text-shadow:
        0 0 10px #00ffcc,
        0 0 25px #00ffcc;
}

.top-panel {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

select,
button {
    border: none;
    outline: none;
    padding: 10px 18px;
    border-radius: 8px;
    background: #151d2e;
    color: white;
    border: 1px solid #34415c;
    font-size: 15px;
    cursor: pointer;
}

button:hover,
select:hover {
    background: #202b42;
}

#gameCanvas {
    width: 100%;
    max-width: 1000px;
    height: auto;
    border-radius: 14px;
    border: 2px solid rgba(255,255,255,0.3);
    box-shadow:
        0 0 20px rgba(0,255,200,0.15),
        0 0 60px rgba(0,150,255,0.1);
    background: #05070c;
}

.controls {
    margin-top: 10px;
    color: #8f9bb3;
    font-size: 14px;
}

.controls span {
    color: #fff;
    font-weight: bold;
}

#startScreen,
#winScreen {
    position: fixed;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(2,5,10,0.88);
    backdrop-filter: blur(10px);
    z-index: 10;
}

.modal {
    width: min(90%, 500px);
    padding: 40px;
    border-radius: 20px;
    background: linear-gradient(145deg, #101827, #080d16);
    border: 1px solid #34415c;
    box-shadow:
        0 0 30px rgba(0,255,200,0.15);
}

.modal h2 {
    font-size: 42px;
    margin-top: 0;
    color: #00ffcc;
    text-shadow: 0 0 15px #00ffcc;
}

.modal p {
    color: #aab4c8;
}

.big-button {
    margin-top: 20px;
    padding: 14px 35px;
    font-size: 18px;
    background: linear-gradient(90deg, #00b894, #00cec9);
    color: #001510;
    font-weight: bold;
    border: none;
    box-shadow: 0 0 20px rgba(0,255,200,0.3);
}

.big-button:hover {
    transform: scale(1.05);
    background: linear-gradient(90deg, #00cec9, #00b894);
}

.hidden {
    display: none !important;
}

#victoryText {
    font-size: 26px;
    color: white;
}

@keyframes victoryPulse {
    0%,100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.08);
    }
}

.victory-animation {
    animation: victoryPulse 1s infinite;
}

/* ===== CONFETTI ANIMATION ===== */
@keyframes confettiFall {
    0% {
        transform: translateY(0) rotateZ(0deg);
        opacity: 1;
    }
    100% {
        transform: translateY(100vh) rotateZ(720deg);
        opacity: 0;
    }
}

.confetti {
    position: fixed;
    width: 12px;
    height: 12px;
    pointer-events: none;
    z-index: 100;
    animation: confettiFall linear forwards;
}

/* ===== PARTICLE ANIMATION ===== */
@keyframes particleShine {
    0% {
        transform: translate(0, 0) scale(1);
        opacity: 1;
    }
    100% {
        transform: translate(var(--tx), var(--ty)) scale(0);
        opacity: 0;
    }
}

.particle {
    position: fixed;
    font-size: 24px;
    pointer-events: none;
    z-index: 100;
    animation: particleShine ease-out forwards;
}

/* ===== RAINBOW GLOW ===== */
@keyframes rainbowGlow {
    0% {
        text-shadow:
            0 0 10px #ff0000,
            0 0 20px #ff0000;
    }
    25% {
        text-shadow:
            0 0 10px #ff7f00,
            0 0 20px #ff7f00;
    }
    50% {
        text-shadow:
            0 0 10px #00ff00,
            0 0 20px #00ff00;
    }
    75% {
        text-shadow:
            0 0 10px #0000ff,
            0 0 20px #0000ff;
    }
    100% {
        text-shadow:
            0 0 10px #ff0000,
            0 0 20px #ff0000;
    }
}

#winnerTitle {
    animation: rainbowGlow 2s ease-in-out infinite !important;
}
</style>
</head>

<body>

<div class="game-container">

    <h1>🏓 ULTIMATE PONG</h1>

    <div class="top-panel">
        <label>
            Difficulty:
            <select id="difficulty">
                <option value="easy">Easy</option>
                <option value="medium" selected>Medium</option>
                <option value="hard">Hard</option>
            </select>
        </label>

        <label>
            Victory Points:
            <select id="victoryPoints">
                <option value="3">3 Points</option>
                <option value="5" selected>5 Points</option>
                <option value="7">7 Points</option>
                <option value="10">10 Points</option>
            </select>
        </label>

        <button id="soundButton">🔊 Sound ON</button>
    </div>

    <canvas id="gameCanvas" width="1000" height="600"></canvas>

    <div class="controls">
        Player: <span>W / S</span>
        &nbsp;&nbsp;|&nbsp;&nbsp;
        Pause: <span>SPACE</span>
        &nbsp;&nbsp;|&nbsp;&nbsp;
        Restart: <span>R</span>
    </div>

</div>


<!-- START SCREEN -->

<div id="startScreen">

    <div class="modal">

        <h2>🏓 PONG</h2>

        <p>
            Defeat the AI and reach the victory score first!
        </p>

        <p>
            Use <strong>W</strong> and <strong>S</strong> to move.
        </p>

        <button class="big-button" id="startButton">
            START GAME
        </button>

    </div>

</div>


<!-- WIN SCREEN -->

<div id="winScreen" class="hidden">

    <div class="modal victory-animation">

        <h2 id="winnerTitle">🏆 VICTORY!</h2>

        <p id="victoryText"></p>

        <button class="big-button" id="restartButton">
            PLAY AGAIN
        </button>

    </div>

</div>


<script>

const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");

const startScreen = document.getElementById("startScreen");
const winScreen = document.getElementById("winScreen");

const startButton = document.getElementById("startButton");
const restartButton = document.getElementById("restartButton");

const difficultySelect = document.getElementById("difficulty");
const victorySelect = document.getElementById("victoryPoints");

const soundButton = document.getElementById("soundButton");

const winnerTitle = document.getElementById("winnerTitle");
const victoryText = document.getElementById("victoryText");


/* =========================================
   GAME VARIABLES
========================================= */

let gameRunning = false;
let paused = false;

let soundEnabled = true;

let victoryPoints = 5;

let difficulty = "medium";

let playerScore = 0;
let aiScore = 0;

let particles = [];

let scoreAnimations = {
    player: 0,
    ai: 0
};


/* =========================================
   AUDIO SYSTEM
========================================= */

let audioContext = null;

function initAudio() {

    if (!audioContext) {
        audioContext =
            new (window.AudioContext || window.webkitAudioContext)();
    }

    if (audioContext.state === "suspended") {
        audioContext.resume();
    }
}


function playSound(type) {

    if (!soundEnabled) return;

    initAudio();

    const oscillator = audioContext.createOscillator();
    const gainNode = audioContext.createGain();

    oscillator.connect(gainNode);
    gainNode.connect(audioContext.destination);

    let frequency = 400;
    let duration = 0.08;
    let wave = "sine";

    if (type === "paddle") {
        frequency = 500;
        duration = 0.07;
        wave = "square";
    }

    if (type === "wall") {
        frequency = 220;
        duration = 0.06;
        wave = "triangle";
    }

    if (type === "score") {
        frequency = 180;
        duration = 0.25;
        wave = "sawtooth";
    }

    if (type === "victory") {
        playVictorySound();
        return;
    }

    oscillator.type = wave;
    oscillator.frequency.value = frequency;

    gainNode.gain.setValueAtTime(
        0.15,
        audioContext.currentTime
    );

    gainNode.gain.exponentialRampToValueAtTime(
        0.001,
        audioContext.currentTime + duration
    );

    oscillator.start();

    oscillator.stop(
        audioContext.currentTime + duration
    );
}


/* Victory melody */

function playVictorySound() {

    if (!soundEnabled) return;

    initAudio();

    const notes = [
        523.25,
        659.25,
        783.99,
        1046.50
    ];

    notes.forEach((frequency, index) => {

        const oscillator =
            audioContext.createOscillator();

        const gain =
            audioContext.createGain();

        oscillator.connect(gain);
        gain.connect(audioContext.destination);

        oscillator.type = "triangle";

        oscillator.frequency.value = frequency;

        const start =
            audioContext.currentTime + index * 0.18;

        gain.gain.setValueAtTime(0.001, start);

        gain.gain.exponentialRampToValueAtTime(
            0.25,
            start + 0.03
        );

        gain.gain.exponentialRampToValueAtTime(
            0.001,
            start + 0.25
        );

        oscillator.start(start);

        oscillator.stop(start + 0.3);
    });
}


/* =========================================
   VICTORY ANIMATIONS
========================================= */

function createConfetti() {

    const colors = [
        "#00ffcc",
        "#00cec9",
        "#00b894",
        "#00ff7f",
        "#00d4aa",
        "#00e5ff",
        "#7dff00",
        "#ffff00"
    ];

    for (let i = 0; i < 60; i++) {

        const confetti =
            document.createElement("div");

        confetti.className = "confetti";

        confetti.style.left =
            Math.random() * window.innerWidth + "px";

        confetti.style.top =
            "-10px";

        confetti.style.background =
            colors[Math.floor(Math.random() * colors.length)];

        confetti.style.borderRadius =
            Math.random() > 0.5 ? "50%" : "0";

        const duration =
            2 + Math.random() * 2;

        confetti.style.animationDuration =
            duration + "s";

        confetti.style.animationDelay =
            Math.random() * 0.3 + "s";

        document.body.appendChild(confetti);

        setTimeout(() => confetti.remove(), duration * 1000 + 500);
    }
}


function createParticles() {

    const emojis = ["⭐", "✨", "🌟", "💫", "🎆", "🎇"];

    for (let i = 0; i < 30; i++) {

        const particle =
            document.createElement("div");

        particle.className = "particle";

        particle.textContent =
            emojis[Math.floor(Math.random() * emojis.length)];

        const startX = window.innerWidth / 2;
        const startY = window.innerHeight / 2;

        particle.style.left =
            startX + "px";

        particle.style.top =
            startY + "px";

        const angle =
            (Math.random() * Math.PI * 2);

        const distance =
            150 + Math.random() * 250;

        const tx = Math.cos(angle) * distance;
        const ty = Math.sin(angle) * distance;

        particle.style.setProperty("--tx", tx + "px");
        particle.style.setProperty("--ty", ty + "px");

        const duration =
            1.5 + Math.random() * 1;

        particle.style.animationDuration =
            duration + "s";

        particle.style.animationDelay =
            Math.random() * 0.2 + "s";

        document.body.appendChild(particle);

        setTimeout(() => particle.remove(), duration * 1000 + 300);
    }
}


/* =========================================
   PADDLES
========================================= */

const paddle = {
    width: 18,
    height: 120
};

const player = {
    x: 40,
    y: canvas.height / 2 - paddle.height / 2,
    speed: 8,
    targetY: 0
};

const ai = {
    x: canvas.width - 58,
    y: canvas.height / 2 - paddle.height / 2,
    speed: 5,
    targetY: 0
};


/* =========================================
   BALL
========================================= */

const ball = {

    x: canvas.width / 2,
    y: canvas.height / 2,

    size: 14,

    speedX: 7,
    speedY: 3.5,

    maxSpeed: 15,

    trail: []
};


/* =========================================
   KEYBOARD
========================================= */

const keys = {};

document.addEventListener("keydown", function(event) {

    keys[event.key] = true;

    if (event.key === " ") {

        event.preventDefault();

        if (gameRunning) {
            paused = !paused;
        }
    }

    if (
        event.key === "r" ||
        event.key === "R"
    ) {
        restartGame();
    }

});


document.addEventListener("keyup", function(event) {

    keys[event.key] = false;

});


/* =========================================
   DIFFICULTY
========================================= */

function updateDifficulty() {

    difficulty = difficultySelect.value;

    if (difficulty === "easy") {
        ai.speed = 4;
    }

    if (difficulty === "medium") {
        ai.speed = 6;
    }

    if (difficulty === "hard") {
        ai.speed = 9;
    }
}


/* =========================================
   RESET BALL
========================================= */

function resetBall(direction) {

    ball.x = canvas.width / 2;
    ball.y = canvas.height / 2;

    ball.speedX = 7 * direction;

    ball.speedY =
        (Math.random() > 0.5 ? 1 : -1)
        * (3 + Math.random() * 2);

    ball.trail = [];

}


/* =========================================
   PARTICLES
========================================= */

function createParticles(x, y, color, amount = 15) {

    for (let i = 0; i < amount; i++) {

        particles.push({

            x: x,
            y: y,

            vx:
                (Math.random() - 0.5) * 8,

            vy:
                (Math.random() - 0.5) * 8,

            size:
                Math.random() * 5 + 2,

            life: 1,

            color: color
        });

    }

}


function updateParticles() {

    particles.forEach(p => {

        p.x += p.vx;
        p.y += p.vy;

        p.life -= 0.025;

        p.size *= 0.97;

    });

    particles =
        particles.filter(p => p.life > 0);

}


function drawParticles() {

    particles.forEach(p => {

        ctx.globalAlpha = p.life;

        ctx.fillStyle = p.color;

        ctx.beginPath();

        ctx.arc(
            p.x,
            p.y,
            p.size,
            0,
            Math.PI * 2
        );

        ctx.fill();

    });

    ctx.globalAlpha = 1;

}


/* =========================================
   PLAYER MOVEMENT
========================================= */

function updatePlayer() {

    if (keys["w"] || keys["W"]) {
        player.y -= player.speed;
    }

    if (keys["s"] || keys["S"]) {
        player.y += player.speed;
    }

    player.y =
        Math.max(
            0,
            Math.min(
                canvas.height - paddle.height,
                player.y
            )
        );

}


/* =========================================
   AI
========================================= */

function updateAI() {

    let reaction;

    if (difficulty === "easy") {
        reaction = 0.055;
    }

    if (difficulty === "medium") {
        reaction = 0.085;
    }

    if (difficulty === "hard") {
        reaction = 0.13;
    }

    const target =
        ball.y -
        paddle.height / 2;

    ai.y +=
        (target - ai.y) * reaction;

    ai.y =
        Math.max(
            0,
            Math.min(
                canvas.height - paddle.height,
                ai.y
            )
        );

}


/* =========================================
   BALL MOVEMENT
========================================= */

function updateBall() {

    ball.trail.push({
        x: ball.x,
        y: ball.y
    });

    if (ball.trail.length > 12) {
        ball.trail.shift();
    }

    ball.x += ball.speedX;
    ball.y += ball.speedY;


    /* Top / bottom */

    if (
        ball.y <= 0 ||
        ball.y + ball.size >= canvas.height
    ) {

        ball.speedY *= -1;

        createParticles(
            ball.x,
            ball.y,
            "#ffffff",
            8
        );

        playSound("wall");
    }


    /* Player collision */

    if (

        ball.x <= player.x + paddle.width &&

        ball.x + ball.size >= player.x &&

        ball.y + ball.size >= player.y &&

        ball.y <= player.y + paddle.height &&

        ball.speedX < 0

    ) {

        ball.x =
            player.x + paddle.width;

        ball.speedX =
            Math.abs(ball.speedX) + 0.3;


        const hit =
            (ball.y + ball.size / 2) -
            (player.y + paddle.height / 2);

        ball.speedY =
            hit * 0.12;


        if (
            Math.abs(ball.speedX)
            > ball.maxSpeed
        ) {
            ball.speedX =
                ball.maxSpeed;
        }


        createParticles(
            ball.x,
            ball.y,
            "#00ffcc",
            20
        );

        playSound("paddle");
    }


    /* AI collision */

    if (

        ball.x + ball.size >= ai.x &&

        ball.x <= ai.x + paddle.width &&

        ball.y + ball.size >= ai.y &&

        ball.y <= ai.y + paddle.height &&

        ball.speedX > 0

    ) {

        ball.x =
            ai.x - ball.size;

        ball.speedX =
            -Math.abs(ball.speedX) - 0.3;


        const hit =
            (ball.y + ball.size / 2) -
            (ai.y + paddle.height / 2);

        ball.speedY =
            hit * 0.12;


        if (
            Math.abs(ball.speedX)
            > ball.maxSpeed
        ) {
            ball.speedX =
                -ball.maxSpeed;
        }


        createParticles(
            ball.x,
            ball.y,
            "#00aaff",
            20
        );

        playSound("paddle");
    }


    /* AI scores */

    if (ball.x < -ball.size) {

        aiScore++;

        scoreAnimations.ai = 1;

        createParticles(
            canvas.width / 2,
            canvas.height / 2,
            "#00aaff",
            40
        );

        playSound("score");

        checkWinner();

        if (gameRunning) {
            resetBall(1);
        }
    }


    /* Player scores */

    if (ball.x > canvas.width) {

        playerScore++;

        scoreAnimations.player = 1;

        createParticles(
            canvas.width / 2,
            canvas.height / 2,
            "#00ffcc",
            40
        );

        playSound("score");

        checkWinner();

        if (gameRunning) {
            resetBall(-1);
        }
    }

}


/* =========================================
   WINNER
========================================= */

function checkWinner() {

    if (playerScore >= victoryPoints) {

        gameRunning = false;

        winnerTitle.textContent =
            "🏆 YOU WIN!";

        victoryText.textContent =
            `Congratulations! You reached ${victoryPoints} points first.`;

        winScreen.classList.remove("hidden");

        playSound("victory");

        createConfetti();
        createParticles();

    }

    if (aiScore >= victoryPoints) {

        gameRunning = false;

        winnerTitle.textContent =
            "🤖 AI WINS!";

        victoryText.textContent =
            `The AI reached ${victoryPoints} points first.`;

        winScreen.classList.remove("hidden");

        playSound("victory");

        createConfetti();
        createParticles();

    }

}


/* =========================================
   DRAW BACKGROUND
========================================= */

function drawBackground() {

    const gradient =
        ctx.createLinearGradient(
            0,
            0,
            canvas.width,
            canvas.height
        );

    gradient.addColorStop(
        0,
        "#050b12"
    );

    gradient.addColorStop(
        0.5,
        "#08121d"
    );

    gradient.addColorStop(
        1,
        "#05080e"
    );

    ctx.fillStyle = gradient;

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );


    /* Center line */

    ctx.strokeStyle =
        "rgba(255,255,255,0.15)";

    ctx.lineWidth = 3;

    ctx.setLineDash([12, 14]);

    ctx.beginPath();

    ctx.moveTo(
        canvas.width / 2,
        0
    );

    ctx.lineTo(
        canvas.width / 2,
        canvas.height
    );

    ctx.stroke();

    ctx.setLineDash([]);


    /* Center circle */

    ctx.strokeStyle =
        "rgba(255,255,255,0.08)";

    ctx.lineWidth = 4;

    ctx.beginPath();

    ctx.arc(
        canvas.width / 2,
        canvas.height / 2,
        80,
        0,
        Math.PI * 2
    );

    ctx.stroke();

}


/* =========================================
   DRAW PADDLE
========================================= */

function drawPaddle(x, y, color) {

    const gradient =
        ctx.createLinearGradient(
            x,
            y,
            x + paddle.width,
            y
        );

    gradient.addColorStop(
        0,
        color
    );

    gradient.addColorStop(
        0.5,
        "#ffffff"
    );

    gradient.addColorStop(
        1,
        color
    );


    ctx.shadowColor = color;
    ctx.shadowBlur = 20;

    ctx.fillStyle = gradient;

    ctx.beginPath();

    ctx.roundRect(
        x,
        y,
        paddle.width,
        paddle.height,
        9
    );

    ctx.fill();

    ctx.shadowBlur = 0;

}


/* =========================================
   DRAW BALL
========================================= */

function drawBall() {

    /* Trail */

    ball.trail.forEach((point, index) => {

        const alpha =
            index /
            ball.trail.length *
            0.35;

        ctx.globalAlpha = alpha;

        ctx.fillStyle =
            "#ffffff";

        ctx.beginPath();

        ctx.arc(
            point.x + ball.size / 2,
            point.y + ball.size / 2,
            ball.size / 2,
            0,
            Math.PI * 2
        );

        ctx.fill();

    });

    ctx.globalAlpha = 1;


    /* Glow */

    ctx.shadowColor = "#ffffff";
    ctx.shadowBlur = 25;

    ctx.fillStyle = "#ffffff";

    ctx.beginPath();

    ctx.arc(
        ball.x + ball.size / 2,
        ball.y + ball.size / 2,
        ball.size / 2,
        0,
        Math.PI * 2
    );

    ctx.fill();

    ctx.shadowBlur = 0;

}


/* =========================================
   SCORE
========================================= */

function drawScore() {

    let playerScale =
        1 + scoreAnimations.player * 0.5;

    let aiScale =
        1 + scoreAnimations.ai * 0.5;


    ctx.textAlign = "center";

    ctx.font = "bold 70px Arial";


    /* Player */

    ctx.save();

    ctx.translate(
        canvas.width / 2 - 120,
        90
    );

    ctx.scale(
        playerScale,
        playerScale
    );

    ctx.fillStyle = "#00ffcc";

    ctx.shadowColor = "#00ffcc";
    ctx.shadowBlur = 20;

    ctx.fillText(
        playerScore,
        0,
        0
    );

    ctx.restore();


    /* AI */

    ctx.save();

    ctx.translate(
        canvas.width / 2 + 120,
        90
    );

    ctx.scale(
        aiScale,
        aiScale
    );

    ctx.fillStyle = "#00aaff";

    ctx.shadowColor = "#00aaff";
    ctx.shadowBlur = 20;

    ctx.fillText(
        aiScore,
        0,
        0
    );

    ctx.restore();


    scoreAnimations.player *= 0.9;
    scoreAnimations.ai *= 0.9;

}


/* =========================================
   PAUSE
========================================= */

function drawPause() {

    if (!paused) return;

    ctx.fillStyle =
        "rgba(0,0,0,0.55)";

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    ctx.textAlign = "center";

    ctx.font =
        "bold 50px Arial";

    ctx.fillStyle = "#ffffff";

    ctx.fillText(
        "PAUSED",
        canvas.width / 2,
        canvas.height / 2
    );

    ctx.font =
        "18px Arial";

    ctx.fillStyle =
        "#aab4c8";

    ctx.fillText(
        "Press SPACE to continue",
        canvas.width / 2,
        canvas.height / 2 + 40
    );

}


/* =========================================
   MAIN DRAW
========================================= */

function draw() {

    drawBackground();

    drawPaddle(
        player.x,
        player.y,
        "#00ffcc"
    );

    drawPaddle(
        ai.x,
        ai.y,
        "#00aaff"
    );

    drawBall();

    drawParticles();

    drawScore();

    drawPause();

}


/* =========================================
   GAME LOOP
========================================= */

function gameLoop() {

    if (
        gameRunning &&
        !paused
    ) {

        updatePlayer();

        updateAI();

        updateBall();

        updateParticles();

    }

    draw();

    requestAnimationFrame(
        gameLoop
    );

}


/* =========================================
   START GAME
========================================= */

function startGame() {

    initAudio();

    difficulty =
        difficultySelect.value;

    victoryPoints =
        Number(
            victorySelect.value
        );

    updateDifficulty();

    playerScore = 0;

    aiScore = 0;

    player.y =
        canvas.height / 2 -
        paddle.height / 2;

    ai.y =
        canvas.height / 2 -
        paddle.height / 2;

    particles = [];

    paused = false;

    gameRunning = true;

    resetBall(
        Math.random() > 0.5
        ? 1
        : -1
    );

    startScreen.classList.add(
        "hidden"
    );

    winScreen.classList.add(
        "hidden"
    );

}


/* =========================================
   RESTART
========================================= */

function restartGame() {

    if (
        !gameRunning &&
        startScreen.classList.contains("hidden")
    ) {
        startGame();
    }

}


/* =========================================
   BUTTONS
========================================= */

startButton.addEventListener(
    "click",
    startGame
);


restartButton.addEventListener(
    "click",
    startGame
);


difficultySelect.addEventListener(
    "change",
    updateDifficulty
);


victorySelect.addEventListener(
    "change",
    () => {
        victoryPoints =
            Number(
                victorySelect.value
            );
    }
);


soundButton.addEventListener(
    "click",
    () => {

        soundEnabled =
            !soundEnabled;

        soundButton.textContent =
            soundEnabled
            ? "🔊 Sound ON"
            : "🔇 Sound OFF";

        if (soundEnabled) {
            initAudio();
            playSound("paddle");
        }

    }
);


/* =========================================
   START LOOP
========================================= */

updateDifficulty();

gameLoop();

</script>

</body>
</html>
